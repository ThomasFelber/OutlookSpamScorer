# HTML-Seiten: immer beim Server nachfragen (kein stiller Cache-Hit)
# Bei unverändertem ETag → 304, Browser nutzt eigenen Cache → kein extra Download
# Bei neuem Deploy → neuer ETag → 200, Browser lädt frischen Stand
/*.html
  Cache-Control: no-cache, must-revalidate

/Delivery-Reports/*.html
  Cache-Control: no-cache, must-revalidate

# taskpane.js gets updated frequently — always revalidate
/taskpane.js
  Cache-Control: no-cache, must-revalidate

# Other JS/CSS assets are versioned by content hash and safe to cache long-term
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
