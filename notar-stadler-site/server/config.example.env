# Server-Konfiguration (als Umgebungsvariablen setzen, z. B. in der systemd-Unit)
HOST=127.0.0.1
PORT=8080
DIST=/srv/notariat/dist
DB=/srv/notariat/daten/eingaenge.sqlite
SITE_ORIGIN=https://notar-stadler.de
# Einmaliges Token für die Einrichtung der Verwaltung unter /verwaltung/ (danach löschen)
SETUP_TOKEN=
# WebAuthn: Domain der Website (Standard: Host aus SITE_ORIGIN)
RP_ID=notar-stadler.de
SITZUNG_MINUTEN=30
# Nur ohne Verwaltung (Sicherungsweg): öffentlicher Schlüssel aus schluessel.py, 130 Hex-Zeichen
OEFFENTLICHER_SCHLUESSEL=
# zufällig, mindestens 32 Zeichen, z. B.: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
ABHOL_TOKEN=
# Postfach des Notariats für die Benachrichtigung (kein Mandantendatum in der Mail)
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=website@notar-stadler.de
SMTP_PASS=
MAIL_VON=website@notar-stadler.de
MAIL_AN=info@notar-stadler.de
TRUST_PROXY=1
RATE_PRO_STUNDE=10
